# ============================================================
#  Cadence — environment configuration
#  Copy this file to .env and fill in every REQUIRED field.
# ============================================================

# ------ Telegram (REQUIRED) ---------------------------------
# Create a bot via BotFather: https://t.me/BotFather
# Send /newbot, follow prompts, paste token here.
TELEGRAM_BOT_TOKEN=                    # REQUIRED — OQ1
TELEGRAM_BOT_USERNAME=cadence_coord_bot

# Optional: Telegram group chat ID for digest posts.
# Leave blank to DM the lead only (Tier 1 default).
TELEGRAM_GROUP_CHAT_ID=

# ------ Accounts (backend/ on :8001, Postgres) --------------
# One random value shared by backend/ (signs logins) and app/ (checks them).
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://cadence:cadence@localhost:5432/cadence
FRONTEND_URL=http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Optional: Google sign-in and password-reset emails
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_EMAIL=
SMTP_PASSWORD=

# ------ Storage ---------------------------------------------
DATABASE_PATH=./data/cadence.db
TIMEZONE=Asia/Kolkata

# ------ LLM provider ----------------------------------------
# ollama = our server through the SSH tunnel; azure = Azure AI Foundry deployments
LLM_PROVIDER=ollama

# ------ LLM primary when LLM_PROVIDER=azure -----------------
# Endpoint from the deployment's page in Azure AI Foundry. Use one of:
#   https://<resource>.openai.azure.com/openai/v1           (leave API version empty)
#   https://<resource>.services.ai.azure.com/models         (API version 2024-05-01-preview)
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_API_VERSION=
# Deployment names exactly as created in Foundry (not the catalog model name, if you renamed them)
AZURE_COORDINATOR_DEPLOYMENT=
AZURE_PLANNER_DEPLOYMENT=

# ------ LLM primary: Ollama via SSH tunnel ------------------
# The tunnel must be running: ssh -fN ollama-server
# Default local end: localhost:11435 → remote 127.0.0.1:11434
OLLAMA_BASE_URL=http://localhost:11435

# REQUIRED — exact model string pulled on the Ollama server. (OQ2)
# Examples: qwen2.5:14b, llama3.1:8b, nemotron-3-nano:30b
COORDINATOR_MODEL=                     # REQUIRED — OQ2
PLANNER_MODEL=                         # REQUIRED — OQ2

COORDINATOR_NUM_CTX=8192
PLANNER_NUM_CTX=32768
COORDINATOR_THINK=false
PLANNER_THINK=true
OLLAMA_KEEP_ALIVE=24h

# ------ LLM fallback: OpenCode Console ----------------------
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_API_KEY=                      # REQUIRED — OQ3
OPENCODE_MODEL=glm-5.3-flash-free      # re-check free list on demo morning

# Timeouts (seconds)
LLM_TIMEOUT_S=12
PLANNER_TIMEOUT_S=120

# ------ Behaviour -------------------------------------------
# Set DEMO_MODE=true for demo: short timers, auto-accept strong edges
DEMO_MODE=true

FOLLOWUP_CRON=0 10,18 * * *
DIGEST_CRON=0 21 * * *

# Real timers (minutes); DEMO_MODE overrides these at runtime
NUDGE_AFTER_MIN=120          # demo → 2 min
BLOCKER_ESCALATE_MIN=180     # demo → 4 min
RISK_BLOCKED_MIN=120
QUIET_MIN=10                 # demo → 0.5 min (30 s)
UNDO_WINDOW_MIN=30
DEBOUNCE_S=4

# LLM decision thresholds (0–1)
CLARIFY_THRESHOLD=0.6
EDGE_AUTO_ACCEPT=0.8
RUNTIME_EDGE_MIN=0.7

PERSONALISE_FOLLOWUPS=false

# ------ Git claim checker -----------------------------------
# When someone says a task is done, Cadence checks GitHub for a commit or PR
# authored by them. Leave GITHUB_REPO blank to turn the checker off.
# Each participant needs a github_username (set via the participants API).
GITHUB_REPO=                           # owner/repo
GITHUB_TOKEN=                          # fine-grained PAT, read-only "Contents" + "Pull requests"
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_S=8
GIT_CHECK_GRACE_HOURS=24               # accept work from up to this long before the task was created
