# Production build of the dashboard, served by nginx.
# The API addresses are compiled into the site, so they are build arguments:
#   docker build -f Dockerfile.prod \
#     --build-arg VITE_AUTH_API_URL=https://auth.example.com \
#     --build-arg VITE_CADENCE_API_URL=https://api.example.com .
FROM node:20-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_AUTH_API_URL=http://localhost:8001
ARG VITE_CADENCE_API_URL=http://localhost:8000
ENV VITE_AUTH_API_URL=$VITE_AUTH_API_URL \
    VITE_CADENCE_API_URL=$VITE_CADENCE_API_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
